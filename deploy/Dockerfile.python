# svc-orchestrator 镜像（Python · LangGraph）
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1

# 先装依赖（利用缓存）
COPY services/orchestrator/pyproject.toml ./
RUN pip install --no-cache-dir \
      grpcio grpcio-tools protobuf langgraph langchain-core \
      sentence-transformers "psycopg[binary]" pgvector redis httpx

COPY services/orchestrator/ ./
# 注意：镜像构建前需先 `make api-py` 生成 pb/（或在 CI 中生成）。
CMD ["python", "-m", "app.main"]
