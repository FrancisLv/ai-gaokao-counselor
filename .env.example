# 复制为 .env 后填写。切勿提交真实密钥。
# DeepSeek key 只提供给 svc-llm-gateway，不要放到前端或 orchestrator。
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLMGW_DSN=postgresql://francis@localhost:5432/ai_gaokao_counselor
# LLM_PROVIDER_MODE=deepseek
# ORCHESTRATOR_ADDR=[::]:9100
# ORCHESTRATOR_DSN=postgresql://francis@localhost:5432/ai_gaokao_counselor
# ALGO_ADDR=localhost:9002
# LLM_GATEWAY_ADDR=localhost:9001
# ORCHESTRATOR_ENDPOINT=localhost:9100
# GATEWAY_ADDR=:8000
# GATEWAY_DSN=postgresql://francis@localhost:5432/ai_gaokao_counselor
# GATEWAY_COOKIE_SECURE=false
# POLICY_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# POLICY_RETRIEVAL_AS_OF=2025-11-19
